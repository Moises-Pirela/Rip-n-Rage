#node-border {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgb(103, 103, 103);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(43, 43, 43);
    border-right-color: rgb(43, 43, 43);
    border-top-color: rgb(43, 43, 43);
    border-bottom-color: rgb(43, 43, 43);
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
}

#input {
    top: auto;
    align-items: center;
    position: relative;
}

#output {
    bottom: auto;
    align-items: center;
}

#selection-border {
    border-left-color: rgb(83, 167, 255);
    border-right-color: rgb(83, 167, 255);
    border-top-color: rgb(83, 167, 255);
    border-bottom-color: rgb(83, 167, 255);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

:hover > #selection-border {
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

:selected > #selection-border {
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

:hover:selected > #selection-border {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
}

.node {
    min-width: 150px;
    min-height: auto;
    max-width: none;
    max-height: none;
    width: auto;
    height: auto;
}

#title {
    align-items: center;
    justify-content: flex-start;
    -unity-font-style: bold;
    font-size: 14px;
}

#description {
    font-size: 10px;
    -unity-font-style: italic;
    align-items: center;
    justify-content: center;
    max-width: 150px;
    flex-grow: 0;
    max-height: none;
    overflow: hidden;
    flex-wrap: wrap;
    white-space: normal;
}

#divider {
    min-height: 1px;
    background-color: rgb(255, 255, 255);
}

.action #input {
    background-color: rgb(62, 97, 140);
    flex-grow: 0;
}

.composite #input {
    background-color: rgb(255, 154, 0);
}

.decorator #input {
    background-color: rgb(201, 172, 242);
}

.root #input {
    background-color: rgb(255, 255, 255);
    height: 25px;
}

#node-state {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
}

.running #node-state {
    background-color: rgb(248, 255, 0);
}

.success #node-state {
    background-color: rgb(0, 255, 42);
}

.failure #node-state {
    background-color: rgb(255, 30, 0);
}

.selector #input {
    background-color: rgba(149, 0, 255, 255);
}
