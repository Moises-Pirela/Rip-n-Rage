<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <uie:Toolbar>
        <Style src="BehaviorTreeEditor.uss" />
        <uie:ToolbarMenu name="Assets" tooltip="Assets" text="Assets" />
    </uie:Toolbar>
    <SplitView style="left: 0; width: 100%; height: 100%; flex-grow: 1; position: relative; top: 0;">
        <Style src="BehaviorTreeEditor.uss" />
        <ui:VisualElement name="left-panel" style="width: 154px;">
            <SplitView orientation="Vertical">
                <ui:VisualElement name="inspector-container" style="height: 220px;">
                    <ui:Label text="Inspector" name="InspectorLabel" style="background-color: rgb(48, 48, 48);" />
                    <InspectorView style="flex-grow: 1; background-color: rgb(38, 38, 38);" />
                </ui:VisualElement>
                <ui:VisualElement name="blackboard-container">
                    <ui:Label text="Blackboard" name="blackboard-label" />
                    <ui:IMGUIContainer />
                </ui:VisualElement>
            </SplitView>
        </ui:VisualElement>
        <ui:VisualElement name="right-panel" style="width: 214px;">
            <ui:Label text="Behavior Tree" name="BTLabel" style="background-color: rgb(48, 48, 48);" />
            <BehaviorTreeView focusable="true" style="flex-grow: 1;" />
        </ui:VisualElement>
    </SplitView>
</ui:UXML>
