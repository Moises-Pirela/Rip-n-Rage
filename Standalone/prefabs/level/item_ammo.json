// The base ammo pickup: a static trigger sphere that carries the ammo, and a billboard sprite child that bobs.
// The amount comes from the type's table row unless a map says otherwise.
{ "name": "item_ammo",
  "description": "Ammo pickup",
  "keys": { "amount": "Pickup.amount" },
  "editor": { "gizmoColor": [1, 0.9, 0.3, 1], "pickExtents": [0.7, 0.7, 0.7] },
  "components": {
    "LocalTransform": { "position": [0, 0.9, 0] },
    "ColliderShape": { "kind": "Sphere", "radius": 1.5, "isStatic": true },
    "CollisionFilter": { "layer": 14 },
    "Trigger": {},
    "Pickup": { "ammo": "LIGHT" },
    "LevelRef": {}
  },
  "children": {
    "sprite": {
      "components": {
        "LocalTransform": { "scale": [0.75, 0.75, 1] },
        "SpriteRender": { "sprite": "Pickups/pickup_lightammo", "billboard": true, "lit": true, "castsShadow": false },
        "Bob": { "ammo": "LIGHT" } } } } }
