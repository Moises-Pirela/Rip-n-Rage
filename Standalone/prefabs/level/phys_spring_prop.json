  "keys": { "size": ["BoxMesh.size", "ShapeSize.size"], "mass": "Body.mass", "texture": "LevelTextured.texture", "shape": "ColliderShape.kind",
            "length": "HangsFrom.length", "stiffness": "Joint.stiffness", "damper": "Joint.damping", "max_length": "Joint.maxDistance",
            "break_force": "Joint.breakForce", "break_torque": "Joint.breakTorque" },
