<?xml version="1.0" encoding="utf-8"?>
<!--
  The engine, the game and the level library have zero package dependencies. Only the editors pull one in:
  RipNRage.ImGui references ImGui.NET (Dear ImGui) for the editor UI. nuget.org is otherwise contacted only
  for the .NET runtime packs a self-contained publish (build.sh) needs.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
