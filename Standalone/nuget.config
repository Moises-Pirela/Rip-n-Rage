<?xml version="1.0" encoding="utf-8"?>
<!--
  The standalone build has zero package dependencies. nuget.org is only used for the .NET runtime packs a
  self-contained publish (build.sh) needs; a plain build works offline with just the SDK.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
